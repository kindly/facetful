{
  "name": "facetful",
  "version": "0.6.0",
  "description": "Tiny columnar SQL engine for browser faceting — Rust/wasm, ~240KB gz, zero dependencies. Open Parquet or CSV instantly, facet 1M rows in milliseconds, persist to OPFS; one install gives the library and the `facetful` command.",
  "license": "MIT",
  "author": "David Raznick",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./core": "./core.js",
    "./worker": "./worker.js",
    "./parquet": "./parquet.js",
    "./facetful_wasm.wasm": "./facetful_wasm.wasm",
    "./udfs": {
      "types": "./udfs.d.ts",
      "default": "./udfs.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "core.js",
    "worker.js",
    "parquet.js",
    "udfs.js",
    "udfs.d.ts",
    "bin/facetful.mjs",
    "facetful_wasm.wasm",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "hyparquet": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "hyparquet": {
      "optional": true
    }
  },
  "keywords": [
    "wasm",
    "sql",
    "columnar",
    "parquet",
    "opfs",
    "facets",
    "analytics",
    "browser",
    "csv",
    "cli"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kindly/facetful.git",
    "directory": "js/facetful"
  },
  "homepage": "https://github.com/kindly/facetful#readme",
  "bugs": {
    "url": "https://github.com/kindly/facetful/issues"
  },
  "bin": {
    "facetful": "bin/facetful.mjs"
  }
}
