{
  "name": "facetful",
  "version": "0.8.1",
  "description": "Tiny columnar SQL engine for browser faceting and full-text search — Rust/wasm, under 400 KB gz, with 300 KB (no search) and 250 KB (single-table) builds in the package; nothing else loaded in the browser unless you open Parquet there. Images stream in from a static host, packed and compressed; facet 1M rows in milliseconds, persist to OPFS; one install gives the library and the `facetful` command.",
  "license": "MIT",
  "author": "David Raznick",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./core": "./core.js",
    "./worker": "./worker.js",
    "./parquet": "./parquet.js",
    "./facetful_wasm.wasm": "./facetful_wasm.wasm",
    "./udfs": {
      "types": "./udfs.d.ts",
      "default": "./udfs.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "core.js",
    "worker.js",
    "parquet.js",
    "fzstd.js",
    "udfs.js",
    "udfs.d.ts",
    "bin/facetful.mjs",
    "bin/size.mjs",
    "facetful_wasm.wasm",
    "facetful_sql.wasm",
    "facetful_lite.wasm",
    "facetful_cli.wasm",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "hyparquet": "^1.29.2"
  },
  "keywords": [
    "wasm",
    "sql",
    "columnar",
    "parquet",
    "opfs",
    "facets",
    "analytics",
    "browser",
    "csv",
    "cli"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kindly/facetful.git",
    "directory": "js/facetful"
  },
  "homepage": "https://github.com/kindly/facetful#readme",
  "bugs": {
    "url": "https://github.com/kindly/facetful/issues"
  },
  "bin": {
    "facetful": "bin/facetful.mjs"
  }
}
